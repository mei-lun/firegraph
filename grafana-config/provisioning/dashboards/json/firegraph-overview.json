{
  "annotations": { "list": [] },
  "editable": true,
  "title": "firegraph overview",
  "uid": "firegraph-overview",
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "tags": ["firegraph"],
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS by cmd",
      "description": "每秒请求数（按 cmd 分维）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(firegraph_trace_count_total[1m])) by (cmd)",
          "legendFormat": "{{cmd}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 latency by cmd (ms)",
      "description": "95 分位延迟（毫秒）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green" }, { "color": "yellow", "value": 200 }, { "color": "orange", "value": 500 }, { "color": "red", "value": 1000 } ] },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(firegraph_trace_latency_ms_bucket[5m])) by (cmd, le))",
          "legendFormat": "{{cmd}} p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P99 latency by cmd (ms)",
      "description": "99 分位延迟（毫秒）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green" }, { "color": "yellow", "value": 500 }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 2000 } ] },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(firegraph_trace_latency_ms_bucket[5m])) by (cmd, le))",
          "legendFormat": "{{cmd}} p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error ratio by cmd",
      "description": "失败请求占比",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green" }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.1 } ] },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(firegraph_trace_count_total{ok=\"false\"}[5m])) by (cmd) / sum(rate(firegraph_trace_count_total[5m])) by (cmd)",
          "legendFormat": "{{cmd}} err%"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Profile upload rate (/min)",
      "description": "每分钟 profile 上报数",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "blue" } ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(firegraph_profile_count_total[1m])) * 60",
          "legendFormat": "profiles/min"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total traces received",
      "description": "累计接收 trace 总数",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green" } ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(firegraph_trace_count_total)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Avg profile samples",
      "description": "平均单 profile 采样点数",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(firegraph_profile_samples_sum[5m]) / rate(firegraph_profile_samples_count[5m])",
          "legendFormat": "{{service}} avg samples"
        }
      ]
    }
  ]
}
